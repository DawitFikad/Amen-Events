# ====================================================================
# Supabase PostgreSQL Connection Strings
# ====================================================================
# 1. DATABASE_URL: Supabase Transaction Connection Pooler (Port 6543)
# Used at runtime by Prisma and serverless functions to prevent connection exhaustion.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Supabase Direct Connection (Port 5432)
# Used by Prisma CLI for running migrations and `prisma db push`.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ====================================================================
# Security & JWT Secrets (Change these in production!)
# ====================================================================
JWT_SECRET="super-secret-jwt-key-replace-with-random-uuid-or-hash"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-with-random-uuid-or-hash"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ====================================================================
# Server & CORS Configuration
# ====================================================================
PORT=4000
# Comma-separated list of allowed frontend origins (or wildcard *):
CLIENT_URL="http://localhost:5173,https://your-frontend.vercel.app"
